{
    "name": "kanopi/wordpress-core",
    "description": "WordPress core, mirrored from wordpress.org for Composer.",
    "type": "wordpress-core",
    "license": "GPL-2.0-or-later",
    "homepage": "https://wordpress.org/",
    "keywords": [
        "wordpress",
